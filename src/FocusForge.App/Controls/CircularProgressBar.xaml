<UserControl x:Class="FocusForge.App.Controls.CircularProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="120" Height="120">
    <Grid>
        <!-- Background Track -->
        <Ellipse Stroke="{DynamicResource ProgressBackgroundBrush}" StrokeThickness="{Binding StrokeThickness, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        
        <!-- Progress Arc -->
        <Path Stroke="{Binding ProgressBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" 
              StrokeThickness="{Binding StrokeThickness, RelativeSource={RelativeSource AncestorType=UserControl}}"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              RenderTransformOrigin="0.5,0.5">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="{Binding StartPoint, RelativeSource={RelativeSource AncestorType=UserControl}}" IsClosed="False">
                        <ArcSegment Point="{Binding EndPoint, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    Size="{Binding ArcSize, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    IsLargeArc="{Binding IsLargeArc, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    SweepDirection="Clockwise" />
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <!-- Center Text -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding PercentageText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="24" FontWeight="Bold" Foreground="{Binding TextBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" />
            <TextBlock Text="complete" FontSize="10" Foreground="{Binding TextBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" Opacity="0.8" HorizontalAlignment="Center" Margin="0,-2,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
