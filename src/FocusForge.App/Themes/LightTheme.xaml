<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base Colors -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InkBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4272F1" />
    <SolidColorBrush x:Key="WarmBrush" Color="#F7861B" />
    <SolidColorBrush x:Key="GraphGridBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ProgressBackgroundBrush" Color="#E2E8F0" />
    
    <!-- Component Colors -->
    <SolidColorBrush x:Key="NavButtonHoverBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GhostButtonBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="GhostButtonBorderBrush" Color="#E2E8F0" />

    <!-- Schedule Blocks -->
    <SolidColorBrush x:Key="ScheduleDeepWorkBg" Color="#EBF1FE" />
    <SolidColorBrush x:Key="ScheduleDeepWorkFg" Color="#4272F1" />
    <SolidColorBrush x:Key="ScheduleLunchBg" Color="#FEF5E8" />
    <SolidColorBrush x:Key="ScheduleLunchFg" Color="#F3A919" />
    <SolidColorBrush x:Key="ScheduleMoveBg" Color="#E9F6EE" />
    <SolidColorBrush x:Key="ScheduleMoveFg" Color="#26A557" />
    
    <!-- Pastel accents -->
    <SolidColorBrush x:Key="TaskWorkAccent" Color="#4272F1" />
    <SolidColorBrush x:Key="TaskNotesAccent" Color="#F3A919" />
    <SolidColorBrush x:Key="TaskMoveAccent" Color="#26A557" />
    <SolidColorBrush x:Key="TaskPlanAccent" Color="#3C008B" />
</ResourceDictionary>
