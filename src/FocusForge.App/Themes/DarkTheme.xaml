<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base Colors -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B0F19" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="InkBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="PanelBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#374151" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4272F1" />
    <SolidColorBrush x:Key="WarmBrush" Color="#F7861B" />
    <SolidColorBrush x:Key="GraphGridBrush" Color="#374151" />
    <SolidColorBrush x:Key="ProgressBackgroundBrush" Color="#1F2937" />
    
    <!-- Component Colors -->
    <SolidColorBrush x:Key="NavButtonHoverBrush" Color="#374151" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GhostButtonBackgroundBrush" Color="#374151" />
    <SolidColorBrush x:Key="GhostButtonBorderBrush" Color="#4B5563" />

    <!-- Schedule Blocks -->
    <SolidColorBrush x:Key="ScheduleDeepWorkBg" Color="#1A2954" />
    <SolidColorBrush x:Key="ScheduleDeepWorkFg" Color="#7A9DF4" />
    <SolidColorBrush x:Key="ScheduleLunchBg" Color="#4D3608" />
    <SolidColorBrush x:Key="ScheduleLunchFg" Color="#F7CA6A" />
    <SolidColorBrush x:Key="ScheduleMoveBg" Color="#0E3D20" />
    <SolidColorBrush x:Key="ScheduleMoveFg" Color="#68D491" />
    
    <!-- Pastel accents -->
    <SolidColorBrush x:Key="TaskWorkAccent" Color="#4272F1" />
    <SolidColorBrush x:Key="TaskNotesAccent" Color="#F3A919" />
    <SolidColorBrush x:Key="TaskMoveAccent" Color="#26A557" />
    <SolidColorBrush x:Key="TaskPlanAccent" Color="#9B6DF1" />
</ResourceDictionary>
