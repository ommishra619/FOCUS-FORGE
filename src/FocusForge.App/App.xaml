<Application x:Class="FocusForge.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#F5F7FB" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA5B8" />
        <SolidColorBrush x:Key="PanelBrush" Color="#161D2B" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#1D2636" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7EE7C7" />
        <SolidColorBrush x:Key="WarmBrush" Color="#FFCF70" />
    </Application.Resources>
</Application>
