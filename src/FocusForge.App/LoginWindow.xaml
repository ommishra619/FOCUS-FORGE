<Window x:Class="FocusForge.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusForge - Login" 
        Width="420"
        SizeToContent="Height"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI"
        MouseDown="Window_MouseDown">
    <Grid Margin="20">
        <!-- Main Card Drop Shadow -->
        <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="20" ShadowDepth="4" Direction="270" />
            </Border.Effect>
        </Border>

        <!-- Inner Content -->
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelAltBrush}" BorderThickness="1" CornerRadius="16" Padding="40,48">
            <StackPanel VerticalAlignment="Center">
                
                <!-- Logo Header -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,32">
                    <Border Width="48" Height="48" Background="{DynamicResource AccentBrush}" CornerRadius="14" Margin="0,0,16,0">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="12" ShadowDepth="2" />
                        </Border.Effect>
                        <TextBlock Text="F" Foreground="{DynamicResource PrimaryButtonForegroundBrush}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="FOCUSFORGE" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}" />
                </StackPanel>
                
                <!-- Welcome Text -->
                <TextBlock x:Name="SubtitleText" Text="Welcome" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock x:Name="InstructionsText" Text="Please enter your name and password." Foreground="{DynamicResource MutedBrush}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,32" />

                <!-- Input Fields -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="NAME" FontSize="11" FontWeight="Bold" Margin="4,0,0,6" Foreground="{DynamicResource MutedBrush}" />
                    <TextBox x:Name="NameTextBox" Height="44" Padding="12,0" Margin="0,0,0,20" 
                             Background="{DynamicResource PanelAltBrush}" Foreground="{DynamicResource InkBrush}" 
                             BorderBrush="{DynamicResource GhostButtonBorderBrush}" BorderThickness="1"
                             VerticalContentAlignment="Center" FontSize="14" />

                    <TextBlock Text="PASSWORD" FontSize="11" FontWeight="Bold" Margin="4,0,0,6" Foreground="{DynamicResource MutedBrush}" />
                    <PasswordBox x:Name="PasswordBox" Height="44" Padding="12,0" Margin="0,0,0,8" 
                                 Background="{DynamicResource PanelAltBrush}" Foreground="{DynamicResource InkBrush}" 
                                 BorderBrush="{DynamicResource GhostButtonBorderBrush}" BorderThickness="1"
                                 VerticalContentAlignment="Center" FontSize="14" />
                </StackPanel>

                <!-- Action Button -->
                <Button x:Name="ActionButton" Content="Enter" Style="{DynamicResource PrimaryButton}" IsDefault="True" Click="ActionButton_Click" Height="48" FontSize="15" FontWeight="Bold" />
                
                <!-- Error Text -->
                <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed" />
                
            </StackPanel>
        </Border>
        
        <!-- Close Button -->
        <Button VerticalAlignment="Top" HorizontalAlignment="Right" Margin="16" Width="30" Height="30" 
                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedBrush}" 
                Cursor="Hand" Click="CloseButton_Click" ToolTip="Close" Content="✕" FontSize="16" FontWeight="Bold" />
    </Grid>
</Window>
