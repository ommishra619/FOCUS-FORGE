<Window x:Class="FocusForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusForge" Width="1280" Height="800" MinWidth="980" MinHeight="640"
        Background="#0D121C" Foreground="{StaticResource InkBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                    <Setter Property="Background" Value="#243044" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#10231F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#263247" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111824" Padding="20,28">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,42">
                        <Border Width="32" Height="32" Background="{StaticResource AccentBrush}" CornerRadius="9" Margin="0,0,10,0">
                            <TextBlock Text="F" Foreground="#10231F" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="FOCUSFORGE" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="#5F6C80" FontSize="11" FontWeight="SemiBold" Margin="16,0,0,10" />
                    <Button Content="◈   Today" Style="{StaticResource NavButton}" Foreground="{StaticResource InkBrush}" Background="#243044" Click="Today_Click" />
                    <Button Content="□   Tasks" Style="{StaticResource NavButton}" Click="Tasks_Click" />
                    <Button Content="▦   Weekly plan" Style="{StaticResource NavButton}" Click="WeeklyPlan_Click" />
                    <Button Content="◷   Focus sessions" Style="{StaticResource NavButton}" Click="FocusSessions_Click" />
                    <TextBlock Text="CONTROL" Foreground="#5F6C80" FontSize="11" FontWeight="SemiBold" Margin="16,32,0,10" />
                    <Button Content="◉   Protected apps" Style="{StaticResource NavButton}" Click="ProtectedApps_Click" />
                    <Button Content="⚙   Settings" Style="{StaticResource NavButton}" Click="Settings_Click" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#1D2636" Padding="14" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="STREAK" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="4 days" FontSize="24" FontWeight="Bold" Margin="0,5,0,2" />
                        <TextBlock Text="Keep the chain alive today." Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="TodayView" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="42,34,48,42">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Friday, September 4" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                    <TextBlock Text="Make today count." FontSize="34" FontWeight="Bold" Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#1D2636" CornerRadius="18" Padding="13,8" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Preview mode" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Button Content="＋  Add task" Style="{StaticResource PrimaryButton}" Click="AddTask_Click" />
                </StackPanel>

                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#1A2532" CornerRadius="12" Margin="0,30,0,28" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CURRENT FOCUS" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="  /  " Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="{Binding FocusTimeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="Deep work session" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,4" />
                            <TextBlock Text="{Binding FocusStatus}" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Finish session" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Click="FinishSession_Click" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,28,0">
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="Today’s tasks" FontSize="20" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock Text="2 of 5 complete" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Width="20" Height="20" Padding="0" Background="Transparent" BorderBrush="#46546A" BorderThickness="1" Content="" Click="TaskCheck_Click" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextDecorations" Value="" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter Property="Opacity" Value="0.55" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeLabel}" Foreground="{Binding Accent}" FontSize="12" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1">
                    <TextBlock Text="Protected right now" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="38" Height="38" Background="#293044" CornerRadius="9" Margin="0,0,12,0">
                                    <Canvas Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="11" Height="11" Canvas.Left="11" Canvas.Top="11" Stroke="#F5F7FB" StrokeThickness="2" />
                                        <Ellipse Width="6" Height="6" Canvas.Left="2" Canvas.Top="3" Fill="#F5F7FB" />
                                        <Path Data="M 6,8 L 14,15" Stroke="#F5F7FB" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Path Data="M 2,13 L 7,16" Stroke="#F5F7FB" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Border>
                                <StackPanel><TextBlock Text="Steam" FontWeight="SemiBold" /><TextBlock Text="{Binding ProtectionState, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{Binding ProtectionColor, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Margin="0,3,0,0" /></StackPanel>
                            </StackPanel>
                            <Border Background="#202B3C" Padding="12" CornerRadius="7" Margin="0,18,0,0">
                                <TextBlock Text="{Binding FocusStatus, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Lock Steam" Style="{StaticResource PrimaryButton}" Click="LockSteam_Click" />
                                <Button Content="Emergency unlock" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="EmergencyUnlock_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <DockPanel Margin="0,28,0,14">
                        <TextBlock Text="Weekly plan" FontSize="20" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <Button Content="＋" ToolTip="Add schedule block" Style="{StaticResource GhostButton}" Padding="10,5" HorizontalAlignment="Right" Click="AddSchedule_Click" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Schedule}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Day}" Foreground="{StaticResource WarmBrush}" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Time}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Duration}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                                <TextBlock Text=" · " Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <ScrollViewer x:Name="SectionView" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="42,34,48,42">
                <TextBlock x:Name="SectionEyebrow" Text="WORKSPACE" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                <TextBlock x:Name="SectionTitle" Text="Tasks" FontSize="34" FontWeight="Bold" Margin="0,7,0,28" />
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="24">
                    <StackPanel>
                        <TextBlock x:Name="SectionDescription" Text="Everything you want to make time for." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,0,0,20" />
                        <ItemsControl x:Name="SectionTasks" ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,8">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                            <TextBlock Text="{Binding TimeLabel}" Foreground="{Binding Accent}" HorizontalAlignment="Right" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="SectionSchedule" Visibility="Collapsed">
                            <Border Background="#111824" BorderBrush="#2B384B" BorderThickness="1" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="44" />
                                        <RowDefinition Height="72" />
                                        <RowDefinition Height="72" />
                                        <RowDefinition Height="72" />
                                        <RowDefinition Height="72" />
                                        <RowDefinition Height="72" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="TIME" Foreground="#5F6C80" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="MON 31" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="TUE 1" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="WED 2" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="THU 3" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Grid.Row="0" Grid.Column="5" Background="#243044" CornerRadius="7" Margin="3,3" />
                                    <TextBlock Grid.Row="0" Grid.Column="5" Text="FRI 4" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="6" Text="SAT 5" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="7" Text="SUN 6" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Text="08 AM" Foreground="#5F6C80" FontSize="10" VerticalAlignment="Top" Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="2" Text="10 AM" Foreground="#5F6C80" FontSize="10" VerticalAlignment="Top" Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="3" Text="12 PM" Foreground="#5F6C80" FontSize="10" VerticalAlignment="Top" Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="4" Text="02 PM" Foreground="#5F6C80" FontSize="10" VerticalAlignment="Top" Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="5" Text="04 PM" Foreground="#5F6C80" FontSize="10" VerticalAlignment="Top" Margin="0,7,0,0" />
                                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="7" BorderBrush="#243044" BorderThickness="0,1,0,0" />
                                    <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="7" BorderBrush="#243044" BorderThickness="0,1,0,0" />
                                    <Border Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="7" BorderBrush="#243044" BorderThickness="0,1,0,0" />
                                    <Border Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="7" BorderBrush="#243044" BorderThickness="0,1,0,0" />
                                    <Border Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="7" BorderBrush="#243044" BorderThickness="0,1,0,0" />
                                    <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Margin="3" Background="#23433D" CornerRadius="6" Padding="8">
                                        <StackPanel><TextBlock Text="Deep work" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11" /><TextBlock Text="09:00 - 10:30" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="5" Margin="3" Background="#423A25" CornerRadius="6" Padding="8">
                                        <StackPanel><TextBlock Text="Lunch + reset" Foreground="{StaticResource WarmBrush}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="11:30 AM" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="5" Margin="3" Background="#29334C" CornerRadius="6" Padding="8">
                                        <StackPanel><TextBlock Text="Move your body" Foreground="#A6B8FF" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="02:00 PM" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Text="Saved schedule blocks" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,18,0,10" />
                            <ItemsControl ItemsSource="{Binding Schedule}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelAltBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,8">
                                            <DockPanel><TextBlock Text="{Binding Day}" Foreground="{StaticResource WarmBrush}" Width="90" /><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding Time}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" /></DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Button x:Name="AddTaskButton" Content="＋  Add task" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="AddTask_Click" />
                        <Button x:Name="AddScheduleButton" Content="＋  Add schedule block" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="AddSchedule_Click" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
